<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="JobNest.Views.ProfilePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Profil"
             BackgroundColor="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="80" />
        </Grid.RowDefinitions>

        <ScrollView Grid.Row="0">
            <StackLayout Padding="0" Spacing="0">

                <!-- Header -->
                <Frame BackgroundColor="#06402B" HasShadow="False" Padding="0" CornerRadius="0">
                    <StackLayout>
                        <Image Source="cover.png"
                               Aspect="AspectFill"
                               HeightRequest="140"/>

                        <Frame BackgroundColor="White" 
                               WidthRequest="100" 
                               HeightRequest="100" 
                               CornerRadius="50" 
                               HasShadow="True"
                               HorizontalOptions="Center"
                               Margin="0,-50,0,0">
                            <Label Text="👤" 
                                   FontSize="50" 
                                   HorizontalOptions="Center" 
                                   VerticalOptions="Center"
                                   TextColor="#06402B" />
                        </Frame>

                        <Label x:Name="UserNameLabel" 
                               Text="Ime Prezime" 
                               FontSize="24" 
                               FontAttributes="Bold" 
                               TextColor="White" 
                               HorizontalOptions="Center"
                               Margin="0,10,0,0" />

                        <Label Text="Kandidat" 
                               FontSize="14" 
                               TextColor="White" 
                               HorizontalOptions="Center"/>
                    </StackLayout>
                </Frame>

                <!-- Contact Info -->
                <StackLayout Padding="20" Spacing="25">

                    <StackLayout Spacing="15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Text="📞" FontSize="18" VerticalOptions="Center"/>
                            <Label Grid.Column="1" x:Name="PhoneLabel"
                                   Text="+387 61 123 456"
                                   FontSize="16"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Text="✉️" FontSize="18" VerticalOptions="Center"/>
                            <Label Grid.Column="1" x:Name="EmailLabel"
                                   Text="email@example.com"
                                   FontSize="16"
                                   VerticalOptions="Center"/>
                        </Grid>
                    </StackLayout>

                    <!-- CV Link Entry -->
                    <Frame BackgroundColor="#06402B"
                           Padding="15"
                           CornerRadius="10"
                           HasShadow="True">
                        <StackLayout Spacing="10">
                            <Label Text="Link ka CV"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="White"/>
                            <Entry x:Name="CvEntry"
                                   Placeholder="Unesite URL link..."
                                   BackgroundColor="White"
                                   TextColor="Black"/>
                            <Button Text="Sačuvaj link"
                                    BackgroundColor="White"
                                    TextColor="#06402B"
                                    Clicked="OnSaveCvLinkClicked"/>
                        </StackLayout>
                    </Frame>

                    <BoxView HeightRequest="20" BackgroundColor="Transparent"/>
                </StackLayout>
            </StackLayout>
        </ScrollView>

        <!-- Bottom Navigation -->
        <Grid Grid.Row="1" BackgroundColor="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackLayout Grid.Column="0" HorizontalOptions="Center" VerticalOptions="Center">
                <Button Text="🏠"
                        BackgroundColor="Transparent"
                        TextColor="#666"
                        FontSize="20"
                        Clicked="OnHomeClicked"/>
                <Label Text="Početna" FontSize="12" TextColor="#666" HorizontalOptions="Center"/>
            </StackLayout>

            <StackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center">
                <Button Text="🔍"
                        BackgroundColor="Transparent"
                        TextColor="#666"
                        FontSize="20"
                        Clicked="OnSearchClicked"/>
                <Label Text="Pretraga" FontSize="12" TextColor="#666" HorizontalOptions="Center"/>
            </StackLayout>

            <StackLayout Grid.Column="2" HorizontalOptions="Center" VerticalOptions="Center">
                <Button Text="🔔"
                        BackgroundColor="Transparent"
                        TextColor="#666"
                        FontSize="20"
                        Clicked="OnNotificationsClicked"/>
                <Label Text="Obavijesti" FontSize="12" TextColor="#666" HorizontalOptions="Center"/>
            </StackLayout>

            <StackLayout Grid.Column="3" HorizontalOptions="Center" VerticalOptions="Center">
                <Button Text="👤"
                        BackgroundColor="Transparent"
                        TextColor="#06402B"
                        FontSize="20"/>
                <Label Text="Profil" FontSize="12" TextColor="#06402B" HorizontalOptions="Center"/>
            </StackLayout>
        </Grid>
    </Grid>
</ContentPage>
