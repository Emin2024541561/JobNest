<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="JobNest.Views.CompanyDashboardPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F8F9FA">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" BackgroundColor="#06402B" Padding="20,50,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackLayout Grid.Column="0">
                <Label x:Name="GreetingLabel"
                       Text="Dobro jutro"
                       FontSize="16"
                       TextColor="White"
                       Opacity="0.8"/>
                <Label x:Name="CompanyNameLabel"
                       Text="Naziv kompanije"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="White"/>
            </StackLayout>

            <!-- Ikonica profila gore desno -->
            <Frame Grid.Column="1"
                   WidthRequest="50"
                   HeightRequest="50"
                   CornerRadius="25"
                   BackgroundColor="White"
                   Padding="0">
                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnProfileClicked"/>
                </Frame.GestureRecognizers>
                <Label Text="🏢"
                       FontSize="24"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
            </Frame>
        </Grid>

        <!-- Content -->
        <ScrollView Grid.Row="1" Padding="20">
            <StackLayout Spacing="25">

                <!-- Quick Stats -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Frame Grid.Column="0" BackgroundColor="White" CornerRadius="15" Padding="20" HasShadow="True" Margin="0,0,10,0">
                        <StackLayout Spacing="10">
                            <Label Text="📋" FontSize="30" HorizontalOptions="Center"/>
                            <Label x:Name="ActiveJobsLabel" Text="0" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#1B5E20"/>
                            <Label Text="Aktivni oglasi" FontSize="14" HorizontalOptions="Center" TextColor="Gray"/>
                        </StackLayout>
                    </Frame>

                    <Frame Grid.Column="1" BackgroundColor="White" CornerRadius="15" Padding="20" HasShadow="True" Margin="10,0,0,0">
                        <StackLayout Spacing="10">
                            <Label Text="👥" FontSize="30" HorizontalOptions="Center"/>
                            <Label x:Name="ApplicationsLabel" Text="0" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#1B5E20"/>
                            <Label Text="Prijave" FontSize="14" HorizontalOptions="Center" TextColor="Gray"/>
                        </StackLayout>
                    </Frame>
                </Grid>

                <!-- Add Job Button -->
                <Button Text="+ OBJAVI NOVI POSAO"
                        BackgroundColor="#06402B"
                        TextColor="White"
                        CornerRadius="25"
                        HeightRequest="50"
                        FontSize="16"
                        FontAttributes="Bold"
                        Margin="0,10,0,0"
                        Clicked="OnAddJobClicked"/>

                <!-- My Job Posts Section -->
                <StackLayout Spacing="15" Margin="0,10,0,0">
                    <Label Text="Moji oglasi"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#06402B"/>

                    <CollectionView x:Name="MyJobsCollectionView">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame BackgroundColor="White" CornerRadius="10" Padding="20" HasShadow="True">
                                    <StackLayout Spacing="5">
                                        <Label Text="{Binding Title}"
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               TextColor="Black"/>
                                        <Label Text="{Binding Location}"
                                               FontSize="14"
                                               TextColor="Gray"/>
                                        <Label Text="{Binding SalaryRange}"
                                               FontSize="14"
                                               TextColor="#06402B"/>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0"
                                                    Text="Uredi"
                                                    BackgroundColor="Transparent"
                                                    TextColor="#06402B"
                                                    BorderColor="#06402B"
                                                    BorderWidth="1"
                                                    CornerRadius="20"
                                                    Clicked="OnEditJobClicked"
                                                    CommandParameter="{Binding .}"/>
                                            <Button Grid.Column="1"
                                                    Text="Obriši"
                                                    BackgroundColor="Transparent"
                                                    TextColor="#D32F2F"
                                                    BorderColor="#D32F2F"
                                                    BorderWidth="1"
                                                    CornerRadius="20"
                                                    Clicked="OnDeleteJobClicked"
                                                    CommandParameter="{Binding .}"/>
                                        </Grid>
                                    </StackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>
            </StackLayout>
        </ScrollView>

        <!-- Bottom Navigation -->
        <Grid Grid.Row="2" BackgroundColor="White" Padding="10,15" HeightRequest="80">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Oglasi -->
            <StackLayout Grid.Column="0" HorizontalOptions="Center" VerticalOptions="Center">
                <Button Text="📋"
                        BackgroundColor="Transparent"
                        TextColor="#06402B"
                        FontSize="20"
                        Clicked="OnHomeClicked"/>
                <Label Text="Oglasi" FontSize="12" TextColor="#06402B" HorizontalOptions="Center"/>
            </StackLayout>

            <!-- Profil -->
            <StackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center">
                <Button Text="🏢"
                        BackgroundColor="Transparent"
                        TextColor="#666"
                        FontSize="20"
                        Clicked="OnProfileClicked"/>
                <Label Text="Profil" FontSize="12" TextColor="#666" HorizontalOptions="Center"/>
            </StackLayout>
        </Grid>
    </Grid>
</ContentPage>
